{
  "name": "urgent-ng-frontend",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "turbo lint typecheck test",
    "clean": "turbo clean && rimraf node_modules",
    "budgets": "node scripts/check-budgets.mjs",
    "audit:prod": "npm audit --omit=dev",
    "contract:check": "node scripts/check-contract.mjs",
    "a11y:browser": "node scripts/check-axe.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
